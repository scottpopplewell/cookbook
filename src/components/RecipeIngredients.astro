---
import { marked } from "marked";

interface Props {
  ingredients: string;
}

const { ingredients } = Astro.props;
const html = ingredients ? await marked(ingredients) : "";
---

{ingredients && (
  <section class="recipe-ingredients" set:html={html} />
)}

<style>
  .recipe-ingredients {
    background-color: #f9f9f9;
    padding: 1rem 1.5rem;
    border-radius: 8px;
    margin: 1.5rem 0;
  }

  .recipe-ingredients :global(h2) {
    margin-top: 0;
    font-size: 1.4rem;
  }

  .recipe-ingredients :global(ul) {
    margin: 0;
    padding-left: 1.5rem;
  }

  .recipe-ingredients :global(li) {
    margin-bottom: 0.5rem;
  }
</style>
